# ---------------------------------------------------------------------------
# Koodam backend — copy to .env and fill in. NEVER commit a real .env
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_NAME=Koodam
APP_URL=http://localhost:3000
CORS_ORIGINS=*

# Database (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgresql://koodam:koodam@localhost:5432/koodam?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# console | whatsapp | twilio  (console prints the OTP to the server log)
OTP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Object storage (S3-compatible). provider: local | s3
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=koodam-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=http://localhost:3000/static

# Payments. provider: mock | razorpay | stripe
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Push notifications. provider: noop | fcm
PUSH_PROVIDER=noop
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Privacy / discovery tuning
GHOST_RADIUS_MIN_M=400
GHOST_RADIUS_MAX_M=900
DEFAULT_SEARCH_RADIUS_KM=15
MAX_SEARCH_RADIUS_KM=200
LOVE_REQUEST_TTL_HOURS=48
REQUIRED_VOUCHES=3

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Feature flags
SWAGGER_ENABLED=true
EVENT_AUTO_PUBLISH=true
